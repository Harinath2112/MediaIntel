# MediaIntel settings - copy this file to ".env" and fill in your own values.
# NEVER commit or share your real .env (it holds your API key and e-mail password).

# ---- 1. YouTube Data API v3 key (REQUIRED - the pipeline never invents data)
# https://console.cloud.google.com -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# ---- 2. Database
# Leave empty to use SQLite (nothing to install). For MySQL uncomment these lines:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=mediaintel

# ---- 3. E-mail alerts sent by the RPA bot
# Gmail: use an "App password" (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT=
# several recipients: a@x.com,b@y.com
# EMAIL_MODE=always            # "alerts_only" = send only when an anomaly exists
# MAX_ALERTS_PER_EMAIL=10      # most alerts listed in one e-mail (highest ratio first)

# ---- 4. Speed profile: trades speed for depth of the Whisper audio analysis
#   fast      Whisper tiny,  first 2 min of audio  x 3 videos/channel/run
#   balanced  Whisper base,  first 4 min of audio  x 4 videos/channel/run   (default)
#   accurate  Whisper small, first 10 min of audio x 10 videos/channel/run  (slowest, most accurate)
SPEED_PROFILE=fast

# ---- 5. Optional fine tuning (uncomment to override the profile)
# VIDEOS_PER_CHANNEL=10              # latest videos fetched per channel
# COMMENT_PAGES=                     # comment pages fetched per video
# WHISPER_VIDEOS_PER_CHANNEL=2       # videos transcribed per channel per run
# WHISPER_MAX_AUDIO_MIN=2            # minutes of audio transcribed per video
# WHISPER_BUDGET_MIN=5               # hard time limit of the Whisper stage (minutes)
# MAX_COMMENTS_PER_VIDEO=25          # RoBERTa analyses the N most-liked comments per video (0 = all comments)
# RELEVANCE_COMMENTS_PER_VIDEO=20    # comments embedded per video for the relevance index
# ANOMALY_THRESHOLD=3                # spike = rate above 3x the channel baseline
# ANOMALY_COOLDOWN_HOURS=24          # no repeat alert for the same video+metric within this time
# (severity: MEDIUM >= 3x, HIGH >= 5x, CRITICAL >= 10x)

# ---- 6. Words that must never become a topic (creator names etc.), comma separated
# TOPIC_EXTRA_STOPWORDS=striver,alakh
